{
  "name": "nuxt-multilang-theme-develop",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "author": "Aleksandar Stajic",
  "license": "MIT",
  "workspaces": [
    "app/admin",
    "app/web",
    "server",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:server": "pnpx nuxi dev server --port 4000",
    "dev": "turbo run dev",
    "build": "pnpm turbo run build",
    "preview": "turbo run preview",
    "lint:old": "eslint app server packages --ext .ts,.vue",
    "lint": "turbo run lint",
    "lint:root": "eslint . --fix --max-warnings=0 --ext .ts,.vue",
    "lint:ci": "eslint app server packages --config eslint.config.ci.mjs --quiet",
    "format": "prettier --write .",
    "clean": "pnpm run clean:root && pnpm run clean:workspaces && pnpm run clean:cache",
    "clean:root": "rm -rf node_modules pnpm-lock.yaml .turbo .nuxt .output dist",
    "clean:workspaces": "find app server packages/shared -type d \\( -name node_modules -o -name .nuxt -o -name .output -o -name .turbo \\) -exec rm -rf {} +",
    "clean:cache": "pnpm store prune",
    "clean:prisma": "rm -rf node_modules/.prisma node_modules/.prisma-client",
    "reinstall": "pnpm run clean && pnpm install && pnpm run postinstall",
    "bootstrap": "pnpm run reinstall",
    "prepare": "husky install",
    "postinstall": "pnpm turbo run postinstall --parallel || true",
    "env:check": "sh -c '[ -f .env ] || (echo \"❌ Missing .env file\" && exit 1)'",
    "env:copy": "cp .env.example .env",
    "db:generate": "pnpm db:pg && pnpm db:mysql && pnpm db:mongo",
    "db:pg": "prisma generate --schema=server/prisma/adapters/schema-postgres.prisma",
    "db:mysql": "prisma generate --schema=server/prisma/adapters/schema-mysql.prisma",
    "db:mongo": "prisma generate --schema=server/prisma/adapters/schema-mongo.prisma",
    "migrate:wp": "ts-node server/migrate/migrate.ts"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/schema": "^4.1.3",
    "@types/node": "^24.8.1",
    "husky": "^9.1.7",
    "lodash": "^4.17.21",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.1.1",
    "@pinia/nuxt": "^0.11.2",
    "@prisma/client": "^6.17.1",
    "ioredis": "^5.8.1",
    "mongodb": "^6.20.0",
    "mysql2": "^3.15.2",
    "nuxt-security": "^2.4.0",
    "pinia-plugin-persistedstate": "^4.5.0",
    "nuxt": "^4.1.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "engines": {
    "node": ">=24.5.0",
    "pnpm": "^10.18.1"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ],
    "ignoredBuiltDependencies": [
      "sharp",
      "vue-demi"
    ]
  }
}
