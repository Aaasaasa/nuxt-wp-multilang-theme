// server/nitro.config.ts
import { defineNitroConfig } from 'nitropack/config'
import { resolve } from 'pathe'

export default defineNitroConfig({
  // 🔧 Lokacija izvornog koda (u server paketu)
  srcDir: resolve(import.meta.dirname),

  // 🔒 Stabilna verzija kompatibilnosti (obavezno za Nuxt 4)
  compatibilityDate: '2025-10-06',

  // ⚙️ Deployment tip (lokalni Node server)
  preset: 'node-server',

  // 🚀 ESBuild podešavanje – dozvoljava top-level await i ESM
  esbuild: {
    options: {
      define: {
        'buffer.hasOwnProperty': 'Object.prototype.hasOwnProperty.call',
      },
      target: 'esnext',
      format: 'esm'
    }
  },

  // 📁 Skendiraj foldere sa API rutama i servisima
  scanDirs: [
    resolve(import.meta.dirname, 'api'),
    resolve(import.meta.dirname, 'routes'),
    resolve(import.meta.dirname, 'lib'),
    resolve(import.meta.dirname, 'utils')
  ],

  // 🧩 Prisma + vanjske biblioteke — sprečava bundlanje .prisma klijenata
  externals: {
    inline: ['@prisma/client', '.prisma/client'],
    external: ['.prisma/client/index-browser', 'openapi3-ts']
  },

  // ⛔ Zabrani Nitro-u da pokušava bundlati Node module
  noExternals: true,

  // 🧠 Prisma generisani klijenti imaju side-effects → zadrži ih
  moduleSideEffects: ['@prisma/client', '.prisma/client/index.js'],

  // 🪵 Maksimalan nivo logova
  // verbosity: 3,

  // 🧹 Ignoriši nepotrebne foldere pri buildu
  ignore: ['data', '.nuxt', '.nitro', 'dist', 'logs'],
  rollupConfig: {
    treeshake: false,
    output: {
      preserveModules: false
    }
  },

  // 🧪 Eksperimentalne opcije – stabilizuje async kontekst
  experimental: {
    asyncContext: false
  }
})
