{
  "name": "server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Nuxt 4 server sa API endpointima, Prisma, Redis i multi-DB podrškom (Postgres, MySQL, MongoDB)",
  "main": "./nuxt.config.ts",
  "workspaces": [
    "../packages/shared",
    "../app/web",
    "../app/admin",
    "."
  ],

  "scripts": {
    "dev": "nuxt dev --port 4000",
    "build": "nuxt build",
    "start": "nuxt start",
    "preview": "nuxt preview",
    "postinstall": "echo '✅ Server postinstall complete'",
    "lint": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write .",
    "migrate": "ts-node migrate/migrate.ts",
    "db:generate": "pnpm db:pg && pnpm db:mysql && pnpm db:mongo"
  },

  "dependencies": {
    "@prisma/client": "^6.17.1",
    "dotenv": "^17.2.3",
    "h3": "^2.0.1-rc.2",
    "ioredis": "^5.8.1",
    "mongodb": "^6.20.0",
    "mysql2": "^3.15.2",
    "openapi3-ts": "^4.5.0",
    "pathe": "^2.0.3"
  },

  "devDependencies": {
    "@nuxt/kit": "^4.1.3",
    "nuxt": "^4.1.3",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4"
  },

  "engines": {
    "node": ">=24.5.0"
  }
}
