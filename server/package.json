    "db:migrate": "prisma migrate dev --name shared-migration"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "h3": "^1.15.4",
    "ioredis": "^5.8.0",
    "mysql2": "^3.15.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "nuxt": "^4.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "swagger-jsdoc": "^6.2.8",
    "typescript": "^5.9.2"
  }
}
