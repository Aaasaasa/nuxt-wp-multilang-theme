{
  "name": "server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 4000",
    "build": "nuxt build",

    "start": "node .output/server/index.mjs",
    "lint": "eslint . --fix",
    "format": "prettier --write .",

    "db:generate": "pnpm db:generate:pg && pnpm db:generate:mysql && pnpm db:generate:mongo",

    "db:generate:pg": "prisma generate --schema=../prisma/adapters/schema-postgres.prisma",
    "db:generate:mysql": "prisma generate --schema=../prisma/adapters/schema-mysql.prisma",
    "db:generate:mongo": "prisma generate --schema=../prisma/adapters/schema-mongo.prisma"

  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "h3": "^1.15.4",
    "ioredis": "^5.8.0",
    "mysql2": "^3.15.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "nuxt": "^4.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.16.3",
    "swagger-jsdoc": "^6.2.8",
    "typescript": "^5.9.2"
  }
}
