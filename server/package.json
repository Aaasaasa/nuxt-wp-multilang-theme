{
  "name": "server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 4000",
    "build": "nuxt build",
    "start": "nuxt start",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
