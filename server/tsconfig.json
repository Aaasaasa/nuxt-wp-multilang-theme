{
  "extends": "../tsconfig.base.json",
  "module": "NodeNext",
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "~~/*": ["../shared/*"]
    }
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src", "prisma", "index.ts"]
}
