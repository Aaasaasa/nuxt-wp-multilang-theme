{
  "name": "nuxt-multilang-theme-develop",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "server",
    "shared"
  ],
  "version": "0.0.1",
  "author": "Aleksandar Stajic",
  "license": "MIT",
  "homepage": "https://github.com/Aaasaasa/nuxt-wp-multilang-theme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaasaasa/nuxt-wp-multilang-theme"
  },
  "bugs": {
    "url": "https://github.com/Aaasaasa/nuxt-wp-multilang-theme"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:server": "turbo run dev --filter=server",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "eslint . --ext .js,.ts,.vue --fix",
    "test": "turbo run test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "postinstall": "turbo run postinstall || true",
    "env:check": "sh -c '[ -f .env ] || (echo \"ERROR: Missing .env file\" && exit 1)'",
    "env:copy": "cp .env.example .env",
    "prepare": "husky",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:coverage": "vitest run --coverage",
    "db:studio": "prisma studio",
    "changelog:generate": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "changelog:preview": "conventional-changelog -p conventionalcommits -u",
    "version:check": "echo \"Current version: $(node -p \"require('./package.json').version\")\" && git status --porcelain",
    "tag:patch": "npm run changelog:generate && git add CHANGELOG.md && git commit --no-verify -m \"chore: update changelog\" || true && npm version patch && git push --follow-tags",
    "tag:minor": "npm run changelog:generate && git add CHANGELOG.md && git commit --no-verify -m \"chore: update changelog\" || true && npm version minor && git push --follow-tags",
    "tag:major": "npm run changelog:generate && git add CHANGELOG.md && git commit --no-verify -m \"chore: update changelog\" || true && npm version major && git push --follow-tags"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.60",
    "@iconify-json/openmoji": "^1.2.9",
    "@nuxt/image": "1.11.0",
    "@nuxt/ui": "3.3.0",
    "@nuxtjs/i18n": "10.0.3",
    "@nuxtjs/seo": "^3.1.0",
    "@pinia/nuxt": "^0.11.2",
    "@prisma/adapter-pg": "^6.13.0",
    "@prisma/client": "^6.16.1",
    "@prisma/nuxt": "^0.3.0",
    "nuxt": "^4.1.1",
    "nuxt-auth-utils": "^0.5.22",
    "nuxt-security": "^2.3.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "^9.35.0",
    "@nuxt/eslint": "1.7.1",
    "@nuxt/test-utils": "3.19.2",
    "@playwright/test": "1.54.2",
    "@swc-node/register": "^1.11.1",
    "@types/node": "^24.1.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "conventional-changelog-cli": "5.0.0",
    "conventional-changelog-writer": "8.2.0",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "happy-dom": "18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "playwright-core": "1.54.2",
    "prisma": "^6.13.0",
    "swagger-jsdoc": "^6.2.8",
    "tsx": "^4.20.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=24.5.0",
    "npm": ">=11.0.0"
  },
  "packageManager": ">=npm@11.0.0"
}
