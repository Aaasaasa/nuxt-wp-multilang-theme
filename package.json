{
  "name": "nuxt-multilang-theme-develop",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "server",
    "shared"
  ],
  "version": "0.0.1",
  "author": "Aleksandar Stajic",
  "license": "MIT",
  "scripts": {
    "dev:web": "turbo run dev --filter=web",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:server": "turbo run dev --filter=server",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint:sam": "eslint . --fix",
    "lint": "pnpm run lint:root",
    "lint:root": "eslint app server shared --config eslint.config.mjs --fix",
    "lint:ci": "eslint app server shared --quiet --max-warnings=0 --config eslint.config.ci.mjs --no-cache || true",
    "lint:all": "turbo run lint",
    "test": "turbo run test",
    "postinstall": "turbo run postinstall || true",
    "env:check": "sh -c '[ -f .env ] || (echo \"ERROR: Missing .env file\" && exit 1)'",
    "env:copy": "cp .env.example .env",
    "prepare": "husky install",
    "clean:root": "rm -rf node_modules pnpm-lock.yaml .turbo .nuxt .output dist",
    "clean:workspaces": "rm -rf app/*/node_modules app/*/.nuxt app/*/.output app/*/.turbo server/node_modules shared/node_modules",
    "clean:prisma": "rm -rf node_modules/.prisma node_modules/.prisma-client",
    "clean:cache": "pnpm store prune",
    "clean": "pnpm run clean:root && pnpm run clean:workspaces && pnpm run clean:prisma && pnpm run clean:cache",
    "reinstall": "pnpm run clean && pnpm install && pnpm run postinstall",
    "bootstrap": "pnpm run reinstall",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vue-eslint-parser": "^9.4.3"
  },
  "engines": {
    "node": ">=24.5.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.17.1"
}
