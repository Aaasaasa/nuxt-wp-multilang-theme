{
  "name": "nuxt-multilang-theme-develop",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "author": "Aleksandar Stajic",
  "license": "MIT",
  "homepage": "https://stajic.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaasaasa/nuxt-multilang-theme-develop.git"
  },
  "bugs": {
    "url": "https://github.com/Aaasaasa/nuxt-multilang-theme-develop/issues"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "turbo run dev",
    "dev:nuxt": "nuxt dev",
    "preview": "nuxt preview",
    "lint": "pnpm run lint:prettier && npm run lint:eslint",
    "lint:eslint": "eslint . --fix --ignore-pattern volumes/",
    "lint:prettier": "prettier --write --list-different .",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "env:check": "sh -c '[ -f .env ] || (echo \"❌ Missing .env file\" && exit 1)'",
    "env:copy": "cp .env.example .env",
    "db:generate": "pnpm db:pg && pnpm db:mysql && pnpm db:mongo",
    "db:pg": "prisma generate --schema=prisma/adapters/schema-postgres.prisma",
    "db:mysql": "prisma generate --schema=prisma/adapters/schema-mysql.prisma",
    "db:mongo": "prisma generate --schema=prisma/adapters/schema-mongo.prisma",
    "migrate:wp": "ts-node migrate/migrate.ts",
    "changelog": "pnpx git-cliff --output CHANGELOG.md",
    "release:patch": "pnpm version patch && git push --follow-tags",
    "release:minor": "pnpm version minor && git push --follow-tags",
    "release:major": "pnpm version major && git push --follow-tags",
    "clean": "pnpm run clean:root && pnpm run clean:workspaces && pnpm run clean:cache",
    "clean:root": "rm -rf node_modules pnpm-lock.yaml .turbo .nuxt .output dist",
    "clean:workspaces": "find app server shared -type d \\( -name node_modules -o -name .nuxt -o -name .output -o -name .turbo \\) -exec rm -rf {} +",
    "clean:cache": "pnpm store prune",
    "clean:prisma": "rm -rf node_modules/.prisma node_modules/.prisma-client",
    "reinstall": "pnpm run clean && pnpm install && pnpm run postinstall",
    "bootstrap": "pnpm run reinstall"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.63",
    "@iconify-json/openmoji": "^1.2.17",
    "@intlify/core": "^11.1.12",
    "@intlify/core-base": "^11.1.12",
    "@intlify/message-compiler": "^11.1.12",
    "@intlify/shared": "^11.1.12",
    "@intlify/utils": "^0.13.0",
    "@nuxt/fonts": "^0.11.4",
    "@nuxt/icon": "^2.0.0",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/color-mode": "^3.5.2",
    "@nuxtjs/i18n": "^10.1.1",
    "@nuxtjs/robots": "^5.5.6",
    "@nuxtjs/seo": "^3.2.2",
    "@nuxtjs/sitemap": "^7.4.7",
    "@pinia/nuxt": "^0.11.2",
    "@prisma/client": "6.17.1",
    "@prisma/nuxt": "0.3.0",
    "h3": "2.0.1-rc.2",
    "handlebars": "^4.7.8",
    "ioredis": "^5.8.1",
    "mongodb": "^6.20.0",
    "mysql2": "^3.15.2",
    "nodemailer": "^6.9.13",
    "nuxt": "^4.1.3",
    "nuxt-auth-utils": "^0.5.25",
    "nuxt-link-checker": "^4.3.6",
    "nuxt-nodemailer": "^1.1.2",
    "nuxt-og-image": "^5.1.12",
    "nuxt-schema-org": "^5.0.9",
    "nuxt-security": "^2.4.0",
    "nuxt-seo-utils": "^7.0.18",
    "nuxt-site-config": "^3.2.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "unhead": "^2.0.19",
    "vue-i18n": "^11.1.12",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.9.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.38.0",
    "happy-dom": "18.0.1",
    "husky": "^9.1.7",
    "nuxt-mcp": "^0.2.4",
    "playwright-core": "^1.56.1",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "swagger-jsdoc": "^6.2.8",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24.5.0",
    "pnpm": "^10.17.0"
  }
}
