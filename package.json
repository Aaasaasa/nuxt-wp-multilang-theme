{
  "name": "nuxt-multilang-theme-develop",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "author": "Aleksandar Stajic",
  "license": "MIT",
  "homepage": "https://stajic.de",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aaasaasa/nuxt-multilang-theme-develop.git"
  },
  "bugs": {
    "url": "https://github.com/Aaasaasa/nuxt-multilang-theme-develop/issues"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 4000 --host 0.0.0.0",
    "dev:clean": "rm -rf .nuxt .output && nuxt dev --port 4000 --host 0.0.0.0",
    "preview": "nuxt preview",
    "lint": "yarn run lint:prettier && npm run lint:eslint",
    "lint:eslint": "eslint . --fix --ignore-pattern volumes/",
    "lint:prettier": "prettier --write --list-different .",
    "prepare": "husky",
    "test": "yarn run test:unit && yarn run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "env:check": "sh -c '[ -f .env ] || (echo \"❌ Missing .env file\" && exit 1)'",
    "env:copy": "cp .env.example .env",
    "db:seed:ts": "ts-node prisma/seed.ts",
    "db:init": "yarn prisma migrate dev --name init --schema=prisma/adapters/schema-postgres.prisma && yarn prisma generate --schema=prisma/adapters/schema-postgres.prisma",
    "db:generate": "yarn db:pg && yarn db:mysql && yarn db:mongo",
    "db:pg": "prisma generate --schema=prisma/adapters/schema-postgres.prisma",
    "db:mysql": "prisma generate --schema=prisma/adapters/schema-mysql.prisma",
    "db:mongo": "prisma generate --schema=prisma/adapters/schema-mongo.prisma",
    "migrate:wp": "ts-node migrate/migrate.ts",
    "changelog": "pnpx git-cliff --output CHANGELOG.md",
    "release:patch": "yarn version patch && git push --follow-tags",
    "release:minor": "yarn version minor && git push --follow-tags",
    "release:major": "yarn version major && git push --follow-tags",
    "clean": "yarn clean:root && yarn clean:workspaces && yarn clean:cache && yarn clean:prisma",
    "clean:root": "rm -rf node_modules yarn.lock .turbo .nuxt .output dist",
    "clean:workspaces": "find app server shared -type d \\( -name node_modules -o -name .nuxt -o -name .output -o -name .turbo \\) -exec rm -rf {} +",
    "clean:cache": "yarn cache clean",
    "clean:prisma": "rm -rf node_modules/.prisma node_modules/.prisma-client prisma/generated",
    "reinstall": "yarn clean && yarn install --check-files && yarn postinstall",
    "postinstall": "nuxt prepare",
    "bootstrap": "yarn run reinstall"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.70",
    "@iconify-json/openmoji": "^1.2.17",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^4.0.1",
    "@nuxtjs/i18n": "^10.1.1",
    "@nuxtjs/seo": "^3.2.2",
    "@pinia/nuxt": "^0.11.2",
    "@prisma/client": "^6.18.0",
    "@prisma/nuxt": "^0.3.0",
    "bcryptjs": "^3.0.2",
    "handlebars": "^4.7.8",
    "nodemailer": "^7.0.9",
    "nuxt": "^4.1.3",
    "nuxt-auth-utils": "^0.5.25",
    "nuxt-nodemailer": "^1.1.2",
    "nuxt-security": "^2.4.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
    "vue-i18n": "^11.1.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@nuxt/eslint": "^1.9.0",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.9.1",
    "eslint": "^9.38.0",
    "happy-dom": "^20.0.8",
    "husky": "^9.1.7",
    "nuxi": "^3.29.3",
    "nuxt-mcp": "^0.2.4",
    "prettier": "^3.6.2",
    "prisma": "^6.18.0",
    "swagger-jsdoc": "^6.2.8",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.1"
  },
  "prisma": {
    "seed": "tsx ./prisma/seed.ts"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=24.5.0",
    "yarn": "^1.22.22"
  }
}
