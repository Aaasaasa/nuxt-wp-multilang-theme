{
  "name": "@local/shared",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./middleware/*": "./middleware/*.ts",
    "./lib/*": "./lib/*.ts"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "build": "echo 'Shared build (no-op)'",
    "db:generate": "prisma generate --schema=../prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name shared-migration",
    "db:convert": "node scripts/convert-db.js",
    "db:setup": "pnpm db:generate && pnpm db:migrate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "ioredis": "^5.8.0",
    "clsx": "^2.1.1",
    "zod": "^4.1.11",
    "class-variance-authority": "^0.7.1"
  },
  "peerDependencies": {
    "nuxt": "^4.1.3"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "@types/node": "^24.5.2"
  }
}
