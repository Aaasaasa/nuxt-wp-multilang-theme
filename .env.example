SECURE_SESSION_KEY=


# ========================
# Database Configurations
# ========================
# PostgreSQL
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# --- PostgreSQL (existing baza = prisma/schema.prisma) ---
POSTGRES_URL=

# --- PostgreSQL (CMS baza = prisma/adapters/schema-postgres.prisma) ---
POSTGRES_CMS_URL=


# MySQL (WordPress) %23
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=

MYSQL_NAME=
MYSQL_ROOT_PASSWORD=
# --- MySQL (za import / WordPress dump) ---
MYSQL_URL=

# --- MongoDB (za mgArticle i kasnije skaliranje) ---
# MongoDB (New)
MONGO_PORT=
MONGO_ROOT_USER=
MONGO_ROOT_PASSWORD=
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_URL=

# --- Redis (cache/session store) ---
REDIS_URL=

# --- Session secret (Nuxt session module koristi ovo) ---
NUXT_SESSION_SECRET=

# --- Optional: Base URL za server ---
NUXT_PUBLIC_API_BASE=

# --- OpenAPI/Swagger info ---
API_TITLE=
API_VERSION=

# Node:

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# OpenSSL:

# openssl rand -hex 32


# Python:

# python -c "import secrets; print(secrets.token_hex(32))"

PORT=
HOST=
NODE_ENV="development"


