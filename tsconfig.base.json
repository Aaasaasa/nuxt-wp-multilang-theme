{
  "compilerOptions": {
    /* ⚙️ Osnovno */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,

    /* 💡 Za monorepo: root kao baza */
    "baseUrl": ".",
    "paths": {
      "~/*": ["app/*", "server/*"],
      "@/*": ["app/*"],
      "@shared/*": ["packages/shared/*"],
      "#/*": ["packages/shared/*"]
    },

    /* 🧠 Globalni tipovi */
    "types": ["nuxt", "node"],

    /* 🪄 Kvalitet života */
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },

  /* 🗂️ Uključi sve aplikacije */
  "include": [
    "app/**/*",
    "server/**/*",
    "packages/shared/**/*",
    "types/**/*",
    "*.d.ts"
  ],

  /* 🚫 Isključi build output i node_modules */
  "exclude": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist",
    ".turbo"
  ]
}
