{
  "compilerOptions": {
    /* ⚙️ Osnovno */
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,

    /* 💡 Bitno za monorepo */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*", "./server/*"],
      "@/*": ["./app/*"],
      // "#/*": ["./packages/*"],
      "@shared/*": ["./shared/*"],
      // "@utils/*": ["./packages/utils/*"]
    },

    /* 🧠 Tipovi koji su globalno potrebni */
    "types": ["nuxt", "node"],

    /* 🔄 Sprečava preklapanja i zbrku kod TS servera */
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },

  /* 🗂️ Šta sve uključiti */
  "include": [
    "app/**/*",
    "server/**/*",
    "shared/**/*",
    // "packages/**/*",
    "types/**/*",
    "*.d.ts"
  ],

  /* 🚫 Isključi build output i node_modules */
  "exclude": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist"
  ]
}
