{
  "compilerOptions": {
    // ✅ ovako TypeScript zna da podržava import.meta
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // često već imaš ovo:
    "target": "ES2022",        // ili ESNext
    "lib": ["ES2022", "DOM"],  // obavezno da bi radio Vite/Nuxt kod
    "types": ["node"],
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@local/shared/*": ["shared/*"]
    }
  },
  "include": [".", "app/*", "server", "shared"],
  "exclude": ["node_modules", "dist", ".docker", ".output", ".nuxt", ".turbo"]
}
