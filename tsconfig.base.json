{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "types": ["node", "nuxt/schema"],

    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,


    "baseUrl": ".",
    "paths": {
      "@@*": ["./*"],
      "@@shared/*": ["./shared/*"],
      "@@admin/*": ["./app/admin/*"],
      "@@web/*": ["./app/web/*"],
      // "@@prisma/*": ["./prisma/*"],
      "@@server/*": ["./server/*"],
      "#prisma/*": ["prisma/*"],
      "@@prisma/*": ["./prisma/generated/*"],
      "@@public/*": ["./public/*"]
    }
  },
  "typeRoots": ["./node_modules/@types"],
  "include": [
    "app/admin",
    "app/web",
    "server",
    "shared",
    "prisma/generated",
    // "test"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".docker",
    ".output",
    ".nuxt",
    ".turbo"
  ]
}
