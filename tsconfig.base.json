{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@local/shared/*": ["shared/*"]
    }
  },
  "include": ["app/*", "server", "shared"],
  "exclude": ["node_modules", "dist", ".output", ".nuxt", ".turbo"]
}

