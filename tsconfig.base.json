{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@local/shared/*": ["shared/*"]
    }
  },
  "include": [".", "app/*", "server", "shared"],
  "exclude": ["node_modules", "dist", ".docker", ".output", ".nuxt", ".turbo"]
}

