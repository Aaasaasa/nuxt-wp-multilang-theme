{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "~~/*": ["shared/*"]
    },
    "ignoreDeprecations": "6.0",
    "types": []
  },
  "exclude": [
    "node_modules",
    "**/.output",
    "**/.nuxt",
    "**/dist",
    "**/.turbo"
  ],
  "include": [
    "app",
    "server",
    "shared"
  ]
}
