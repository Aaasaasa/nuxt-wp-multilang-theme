{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "types": ["node", "nuxt/schema"],

    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@@*": ["./*"],
      "@@shared/*": ["./shared/*"],
      "@@admin/*": ["./app/admin/*"],
      "@@web/*": ["./app/web/*"],
      "@@prisma/*": ["./prisma/*"],
      "@@server/*": ["./server/*"]
    }
  },
  "include": [
    "app/admin",
    "app/web",
    "server",
    "shared",
    // "test"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".docker",
    ".output",
    ".nuxt",
    ".turbo"
  ]
}
