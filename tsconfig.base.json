{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "~~/*": ["shared/*"]
    },
    "types": ["node"],   // optional global, oder leer lassen
    "references": [
    { "path": "./app/admin/tsconfig.ts" },
    { "path": "./app/web/tsconfig.ts" },
    { "path": "./server/tsconfig.ts" },
    { "path": "./shared/tsconfig.ts" }
  ]
  },
  "exclude": [
    "node_modules",
    "**/.output",
    "**/.nuxt",
    "**/dist",
    "**/.turbo"
  ],
  "include": [
    "app",
    "server",
    "shared"
  ]
}
