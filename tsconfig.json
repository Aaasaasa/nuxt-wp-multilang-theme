{
  "extends": "./.nuxt/tsconfig.json",
  "files": [],
  "references": [
  { "path": "./app/web" },
  { "path": "./app/admin" },
  { "path": "./server" },
  { "path": "./shared" }
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "strict": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": {
    "@shared/*": ["shared/*"],
    "@server/*": ["server/*"],
    "@web/*": ["app/web/*"],
    "@admin/*": ["app/admin/*"]
    }
  }
}
