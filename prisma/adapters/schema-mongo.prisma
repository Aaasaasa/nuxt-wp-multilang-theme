generator mongo {
  provider = "prisma-client-js"
  output   = "./generated/mongo"
  previewFeatures = ["mongoDb"]
}

datasource mongo {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

model mgArticle {
  id      String   @id @map("_id") @default(auto()) @db.ObjectId
  title   String
  body    String?
  tags    String[]
  created DateTime @default(now())
}

