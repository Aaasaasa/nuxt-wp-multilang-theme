{
  "$schema": "https://turborepo.org/schema.json",

  "globalDependencies": [
    "package.json",
    "pnpm-lock.yaml"
  ],

  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "DATABASE_URL",
    "POSTGRES_URL",
    "MYSQL_URL"
  ],

  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [],
      "outputs": []
    },

    "server#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [],
      "outputs": []
    },

    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },

    "lint": {
      "outputs": []
    },

    "test": {
      "outputs": ["coverage/**"]
    },

    "postinstall": {
      "outputs": []
    }
  }
}
