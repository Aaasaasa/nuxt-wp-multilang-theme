{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "#shared/*": ["../../shared/*"]
    },
    "types": ["nuxt", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    "**/*.js",
    "../../shared/**/*.ts"
  ]
}
