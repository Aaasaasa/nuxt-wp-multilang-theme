{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "types": [
      "vue",
      "node",
      "nuxt",
      "nuxt/schema",
      "@nuxt/types"
    ],
    "paths": {
      "@/*": ["./*"],
      "~~/*": ["../../shared/*"]
    }
  },
  "vueCompilerOptions": {
    "target": 3
  },
  "ignoreDeprecations": "5.0",
  "skipLibCheck": true,
  "exclude": ["node_modules", ".output", "dist"],
  "include": [
    "**/*.ts",
    "**/*.vue",
    ".nuxt",
    "nuxt.config.ts",
    "app.vue"
  ]
}
