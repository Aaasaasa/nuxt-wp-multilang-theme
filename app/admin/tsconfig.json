{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "types": ["nuxt/schema", "node"],  // reicht völlig, vue/nuxt wird automatisch aufgelöst
    "paths": {
      "@/*": ["./*"],
      "~~/*": ["../../shared/*"]
    }
  },
  "vueCompilerOptions": {
    "target": 3
  },
  "skipLibCheck": true,
  "exclude": ["node_modules", ".output", "dist"],
  "include": [
    "**/*.ts",
    "**/*.vue",
    ".nuxt",
    "nuxt.config.ts",
    "app.vue"
  ]
}
