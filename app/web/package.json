{
  "name": "web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nuxt 4 admin panel sa TailwindCSS i shared modulima",
  "objasnjenjenje": "Imports subpath za shared, koristi u kodu: import { helper } from '#shared/utils'",
  "objasnjenjenje_dva": "import { locales } from '#shared/utils/locale.ts'",
  "imports": {
    "#shared/*": "../../shared/*"
  },
  "author": "Aleksandar Stajic",
  "license": "MIT",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "preview": "echo 'nuxt preview ne moze da pokrene i .nuxt se generise tek kada pnpm dev bude pokrenut' && nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@nuxt/image": "^1.11.0",
    "@nuxt/ui": "^3.3.5",
    "@nuxtjs/i18n": "^10.1.0",
    "@pinia/nuxt": "^0.11.2",
    "nuxt": "^4.1.2",
    "nuxt-security": "^2.4.0",
    "pinia-plugin-persistedstate": "^4.5.0",
    "tailwindcss": "^4.1.13",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=24.5.0",
    "pnpm": ">=9.0.0"
  }
}
